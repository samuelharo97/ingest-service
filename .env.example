# Defaults for running Node on the host against Compose MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=ingest
PORT=3000
WORKER_CONCURRENCY=128
PROCESSING_DELAY_MS=5000
PROCESSING_TIMEOUT_MS=15000
LEASE_DURATION_MS=30000
LEASE_RENEW_MS=10000
POLL_INTERVAL_MS=250
MAX_ATTEMPTS=5
RETRY_BASE_MS=1000
RETRY_MAX_MS=30000
DB_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=15000
